Package: cdiscdata
Title: Versioned CDISC Standards Reference Data
Version: 0.2.0
Authors@R: c(
    person("Bill", "Denney", email = "wdenney@humanpredictions.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-5759-428X")),
